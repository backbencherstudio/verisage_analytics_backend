# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/verisage_analytics?schema=public"

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id
GA4_CREDENTIALS_PATH=./path/to/service-account-key.json

# Cron Job Schedule (default: every 6 hours)
GA4_SYNC_SCHEDULE="0 */6 * * *"
