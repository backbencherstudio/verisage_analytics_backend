// ====================================================================================
// VERISAGE ANALYTICS - SCALABLE DATABASE SCHEMA
// ====================================================================================
// This schema is designed for production-grade analytics platform with:
// - Proper normalization and relationships
// - Comprehensive indexing for performance
// - Audit trails and event logging
// - Future-proof structure for scaling
// ====================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================================
// AUTHENTICATION & USER MANAGEMENT
// ====================================================================================

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String // Hashed password
  name        String?
  role        String     @default("user") // admin, user, analyst
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String 
  keyHash     String    @unique 
  prefix      String 
  permissions Json? 
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([keyHash])
  @@index([isActive])
  @@map("api_keys")
}

// ====================================================================================
// STRIPE CORE MODELS
// ====================================================================================

model Customer {
  id               String    @id @default(cuid())
  stripeCustomerId String    @unique
  email            String?
  name             String?
  phone            String?
  address          Json? 
  balance          Int       @default(0) 
  currency         String    @default("usd")
  delinquent       Boolean   @default(false)
  metadata         Json?
  stripeCreatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  subscriptions       Subscription[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  subscriptionChanges SubscriptionChange[]
  notes               CustomerNote[]
  tags                CustomerTag[]

  @@index([stripeCustomerId])
  @@index([email])
  @@index([delinquent])
  @@index([createdAt])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  note       String   @db.Text
  createdBy  String? 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_notes")
}

model CustomerTag {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        String // e.g., "vip", "high-value", "at-risk"
  createdAt  DateTime @default(now())

  @@unique([customerId, tag])
  @@index([customerId])
  @@index([tag])
  @@map("customer_tags")
}

model Product {
  id              String    @id @default(cuid())
  stripeProductId String    @unique
  name            String
  description     String?   @db.Text
  isActive        Boolean   @default(true)
  metadata        Json?
  images          Json? 
  stripeCreatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  prices Price[]

  @@index([stripeProductId])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

model Price {
  id                     String    @id @default(cuid())
  stripePriceId          String    @unique
  stripeProductId        String
  product                Product   @relation(fields: [stripeProductId], references: [stripeProductId], onDelete: Cascade)
  nickname               String?
  currency               String    @default("usd")
  unitAmount             Int? 
  recurringInterval      String? 
  recurringIntervalCount Int?      @default(1)
  type                   String 
  billingScheme          String 
  tiersMode              String? 
  tiers                  Json? 
  trialPeriodDays        Int?
  isActive               Boolean   @default(true)
  metadata               Json?
  stripeCreatedAt        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  subscriptionItems SubscriptionItem[]

  @@index([stripePriceId])
  @@index([stripeProductId])
  @@index([recurringInterval])
  @@index([isActive])
  @@map("prices")
}

model Subscription {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  customer             Customer  @relation(fields: [stripeCustomerId], references: [stripeCustomerId], onDelete: Cascade)
  status               String // active, canceled, incomplete, incomplete_expired, trialing, past_due, unpaid, paused
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  cancelAt             DateTime?
  endedAt              DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  billingCycleAnchor   DateTime?
  collectionMethod     String    @default("charge_automatically") 
  daysUntilDue         Int?
  defaultPaymentMethod String?
  discount             Json? 
  metadata             Json?
  stripeCreatedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  items    SubscriptionItem[]
  invoices Invoice[]
  changes  SubscriptionChange[]

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([createdAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id                   String       @id @default(cuid())
  stripeItemId         String       @unique
  stripeSubscriptionId String
  subscription         Subscription @relation(fields: [stripeSubscriptionId], references: [stripeSubscriptionId], onDelete: Cascade)
  stripePriceId        String
  price                Price        @relation(fields: [stripePriceId], references: [stripePriceId])
  quantity             Int          @default(1)
  metadata             Json?
  stripeCreatedAt      DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([stripeItemId])
  @@index([stripeSubscriptionId])
  @@index([stripePriceId])
  @@map("subscription_items")
}

model Invoice {
  id                   String        @id @default(cuid())
  stripeInvoiceId      String        @unique
  stripeCustomerId     String
  customer             Customer      @relation(fields: [stripeCustomerId], references: [stripeCustomerId])
  stripeSubscriptionId String?
  subscription         Subscription? @relation(fields: [stripeSubscriptionId], references: [stripeSubscriptionId])
  number               String? 
  status               String 
  amountDue            Int 
  amountPaid           Int 
  amountRemaining      Int 
  subtotal             Int 
  total                Int 
  tax                  Int? 
  currency             String
  description          String?       @db.Text
  hostedInvoiceUrl     String?       @db.Text
  invoicePdf           String?       @db.Text
  dueDate              DateTime?
  paidAt               DateTime?
  periodStart          DateTime?
  periodEnd            DateTime?
  attemptCount         Int           @default(0)
  attempted            Boolean       @default(false)
  autoAdvance          Boolean       @default(true)
  billingReason        String? 
  metadata             Json?
  stripeCreatedAt      DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Relations
  payments Payment[]
  refunds  Refund[]

  @@index([stripeInvoiceId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
  @@map("invoices")
}

model Payment {
  id                    String    @id @default(cuid())
  stripePaymentIntentId String    @unique
  stripeInvoiceId       String?
  invoice               Invoice?  @relation(fields: [stripeInvoiceId], references: [stripeInvoiceId])
  stripeCustomerId      String
  customer              Customer  @relation(fields: [stripeCustomerId], references: [stripeCustomerId])
  amount                Int 
  amountCapturable      Int       @default(0)
  amountReceived        Int       @default(0)
  currency              String
  status                String 
  paymentMethod         String? 
  paymentMethodBrand    String? 
  paymentMethodLast4    String? 
  description           String?   @db.Text
  receiptEmail          String?
  receiptUrl            String?   @db.Text
  failureCode           String?
  failureMessage        String?   @db.Text
  metadata              Json?
  paidAt                DateTime?
  stripeCreatedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  refunds Refund[]

  @@index([stripePaymentIntentId])
  @@index([stripeInvoiceId])
  @@index([stripeCustomerId])
  @@index([status])
  @@index([paymentMethod])
  @@index([paidAt])
  @@index([createdAt])
  @@map("payments")
}

model Refund {
  id                    String    @id @default(cuid())
  stripeRefundId        String    @unique
  stripePaymentIntentId String?
  payment               Payment?  @relation(fields: [stripePaymentIntentId], references: [stripePaymentIntentId])
  stripeInvoiceId       String?
  invoice               Invoice?  @relation(fields: [stripeInvoiceId], references: [stripeInvoiceId])
  stripeCustomerId      String
  customer              Customer  @relation(fields: [stripeCustomerId], references: [stripeCustomerId])
  amount                Int 
  currency              String
  reason                String? 
  status                String 
  failureReason         String?
  receiptNumber         String?
  metadata              Json?
  refundedAt            DateTime?
  stripeCreatedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([stripeRefundId])
  @@index([stripeCustomerId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@index([refundedAt])
  @@index([createdAt])
  @@map("refunds")
}

model SubscriptionChange {
  id                   String       @id @default(cuid())
  stripeSubscriptionId String
  subscription         Subscription @relation(fields: [stripeSubscriptionId], references: [stripeSubscriptionId], onDelete: Cascade)
  stripeCustomerId     String
  customer             Customer     @relation(fields: [stripeCustomerId], references: [stripeCustomerId])
  changeType           String 
  fromStatus           String?
  toStatus             String?
  fromPriceId          String?
  toPriceId            String?
  fromQuantity         Int?
  toQuantity           Int?
  fromAmount           Int? 
  toAmount             Int? 
  reason               String?      @db.Text
  eventId              String? 
  effectiveDate        DateTime
  metadata             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@index([changeType])
  @@index([effectiveDate])
  @@index([createdAt])
  @@map("subscription_changes")
}

// ====================================================================================
// ANALYTICS & AGGREGATION MODELS
// ====================================================================================

model RevenueSnapshot {
  id                    String   @id @default(cuid())
  date                  DateTime @unique
  period                String 
  totalRevenue          Int      @default(0) 
  totalRefunds          Int      @default(0) 
  netRevenue            Int      @default(0) 
  mrr                   Int      @default(0) 
  arr                   Int      @default(0) 
  newCustomers          Int      @default(0)
  churnedCustomers      Int      @default(0)
  activeSubscriptions   Int      @default(0)
  trialingSubscriptions Int      @default(0)
  newSubscriptions      Int      @default(0)
  canceledSubscriptions Int      @default(0)
  successfulPayments    Int      @default(0)
  failedPayments        Int      @default(0)
  refundCount           Int      @default(0)
  currency              String   @default("usd")
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([date])
  @@index([period])
  @@index([createdAt])
  @@map("revenue_snapshots")
}

// ====================================================================================
// GOOGLE ANALYTICS 4 MODELS
// ====================================================================================

model GA4Metric {
  id                 String   @id @default(cuid())
  date               DateTime
  country            String
  deviceCategory     String
  city               String?
  browser            String?
  operatingSystem    String?
  trafficSource      String?
  activeUsers        Int      @default(0)
  newUsers           Int      @default(0)
  sessions           Int      @default(0)
  engagedSessions    Int      @default(0)
  engagementRate     Float    @default(0)
  eventCount         Int      @default(0)
  conversions        Int      @default(0)
  pageViews          Int      @default(0)
  avgSessionDuration Float    @default(0)
  bounceRate         Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([date, country, deviceCategory, city, browser, operatingSystem, trafficSource])
  @@index([date])
  @@index([country])
  @@index([deviceCategory])
  @@index([createdAt])
  @@map("ga4_metrics")
}

// Aggregated per-event daily totals (materialized from GA4 export if enabled)
model GA4EventAggregate {
  id        String   @id @default(cuid())
  date      DateTime
  eventName String
  total     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, eventName])
  @@index([date])
  @@index([eventName])
  @@map("ga4_event_aggregates")
}

// Aggregated event parameter values (top values per day/event/param)
model GA4EventParamAggregate {
  id         String   @id @default(cuid())
  date       DateTime
  eventName  String
  paramKey   String
  paramValue String?
  total      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([date, eventName, paramKey, paramValue])
  @@index([date])
  @@index([eventName])
  @@index([paramKey])
  @@map("ga4_event_param_aggregates")
}

// ====================================================================================
// SYSTEM & OPERATIONAL MODELS
// ====================================================================================

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String 
  eventType   String 
  eventId     String? 
  payload     Json 
  status      String 
  processedAt DateTime?
  error       String?   @db.Text
  retryCount  Int       @default(0)
  headers     Json? 
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([source, eventId])
  @@index([source])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_events")
}

model ClientWebhookEvent {
  id          String    @id @default(cuid())
  eventId     String?
  eventType   String?
  timestamp   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  tokenId     String?
  userId      String?
  action_Name String?
  durationMs  Int? 
  payload     Json?
  receivedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SyncLog {
  id            String    @id @default(cuid())
  syncType      String    @unique 
  lastSyncAt    DateTime
  nextSyncAt    DateTime?
  status        String 
  recordsSynced Int       @default(0)
  recordsFailed Int       @default(0)
  errorMessage  String?   @db.Text
  duration      Int? 
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([syncType])
  @@index([status])
  @@index([lastSyncAt])
  @@map("sync_logs")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String 
  resource     String 
  resourceId   String?
  changes      Json? 
  ipAddress    String?
  userAgent    String?  @db.Text
  status       String   @default("success") 
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(cuid())
  type       String 
  recipient  String 
  subject    String?
  message    String    @db.Text
  status     String    @default("pending") 
  sentAt     DateTime?
  error      String?   @db.Text
  retryCount Int       @default(0)
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([recipient])
  @@index([createdAt])
  @@map("notifications")
}
